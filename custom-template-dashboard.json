{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Template pour vos metriques metier. Dupliquez ce dashboard et adaptez les requetes PromQL a votre application.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "-- Remplacez: Commandes par minute --",
      "description": "Exemple: rate(orders_total{application=\"$application\"}[5m])",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(your_custom_metric_total{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "custom metric"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "-- Remplacez: Temps de traitement batch --",
      "description": "Exemple: batch_processing_seconds{application=\"$application\"}",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "your_batch_duration_seconds{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "batch duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      }
    },
    {
      "title": "-- Remplacez: File d'attente --",
      "description": "Exemple: queue_size{application=\"$application\"}",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "your_queue_size{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "queue size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "title": "-- Remplacez: Erreurs metier --",
      "description": "Exemple: rate(business_errors_total{application=\"$application\"}[5m])",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(your_business_errors_total{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "KPI 1",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "your_kpi_1{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "KPI 1"
        }
      ]
    },
    {
      "title": "KPI 2",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "your_kpi_2{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "KPI 2"
        }
      ]
    },
    {
      "title": "KPI 3",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "your_kpi_3{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "KPI 3"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["spring-boot", "custom", "business-metrics"],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "query": "label_values(up, application)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(up{application=\"$application\"}, instance)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Spring Boot - Custom Business Metrics (Template)",
  "uid": "spring-boot-custom",
  "version": 1
}

