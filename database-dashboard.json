
{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "HikariCP Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Total"
        },
        {
          "expr": "hikaricp_connections_max{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "HikariCP Pending Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "hikaricp_connections_pending{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Connection Acquire Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"$application\", instance=\"$instance\"}[5m]) / rate(hikaricp_connections_acquire_seconds_count{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "Avg acquire time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Connection Usage Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(hikaricp_connections_usage_seconds_sum{application=\"$application\", instance=\"$instance\"}[5m]) / rate(hikaricp_connections_usage_seconds_count{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "Avg usage time"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Connection Creation Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(hikaricp_connections_creation_seconds_sum{application=\"$application\", instance=\"$instance\"}[5m]) / rate(hikaricp_connections_creation_seconds_count{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "Avg creation time"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Connection Timeout Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(hikaricp_connections_timeout_total{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "Timeouts/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "title": "Pool Usage %",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"$application\", instance=\"$instance\"} / hikaricp_connections_max{application=\"$application\", instance=\"$instance\"} * 100",
          "legendFormat": "Usage %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Idle Connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "hikaricp_connections_idle{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Idle"
        }
      ]
    },
    {
      "title": "Min / Max Pool",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "hikaricp_connections_min{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Min"
        },
        {
          "expr": "hikaricp_connections_max{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "Max"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["spring-boot", "database", "hikaricp", "micrometer"],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "query": "label_values(hikaricp_connections, application)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(hikaricp_connections{application=\"$application\"}, instance)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Spring Boot - Database (HikariCP)",
  "uid": "spring-boot-database",
  "version": 1
}
