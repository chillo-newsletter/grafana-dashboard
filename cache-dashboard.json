{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{application=\"$application\", instance=\"$instance\", result=\"hit\"}[5m])) / sum(rate(cache_gets_total{application=\"$application\", instance=\"$instance\"}[5m])) * 100",
          "legendFormat": "Hit Ratio %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Cache Hits vs Misses",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{application=\"$application\", instance=\"$instance\", result=\"hit\"}[5m])) by (cache)",
          "legendFormat": "{{cache}} hits"
        },
        {
          "expr": "sum(rate(cache_gets_total{application=\"$application\", instance=\"$instance\", result=\"miss\"}[5m])) by (cache)",
          "legendFormat": "{{cache}} misses"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Cache Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "cache_size{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "title": "Cache Evictions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(cache_evictions_total{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "{{cache}} evictions/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Cache Put Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(cache_puts_total{application=\"$application\", instance=\"$instance\"}[5m])",
          "legendFormat": "{{cache}} puts/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["spring-boot", "cache", "micrometer"],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "query": "label_values(cache_gets_total, application)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(cache_gets_total{application=\"$application\"}, instance)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Spring Boot - Cache",
  "uid": "spring-boot-cache",
  "version": 1
}
